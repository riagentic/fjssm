        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "U&konËenÌ",                   ID_APP_EXIT
    END
    POPUP "&⁄pravy"
    BEGIN
        MENUITEM "&Projekt",                    ID_EDIT_PROJECT
        MENUITEM SEPARATOR
        MENUITEM "&Stroje",                     ID_EDIT_MACHINE
