BEGIN
    POPUP "&Projekt"
    BEGIN
        MENUITEM "&Nov˝\tCtrl+N",               ID_FILE_NEW
        MENUITEM "&Otev¯Ìt...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "&Importovat...\tCtrl+I",      ID_FILE_IMPORT
        MENUITEM "&Uloûit\tCtrl+S",             ID_FILE_SAVE
