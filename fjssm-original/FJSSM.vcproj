makehm /h /a afxhh.h IDW_,HIDW_,0x50000 &quot;$(InputFileName)&quot; &gt;&gt; &quot;hlp\HTMLDefines.h&quot;
"
						Outputs="hlp\HTMLDefines.h"/>
				</FileConfiguration>
